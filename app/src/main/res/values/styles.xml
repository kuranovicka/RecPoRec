<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:background">@drawable/key_button_shape</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <!-- Materijal tema po difoltu primorava jedan red bez preloma (tekst se seče, ne
             skracuje sa "..."). Ovo dozvoljava prelazak u 2 reda kad tekst ne stane, i
             skida Materijalov ugradjeni razmak (insetTop/Bottom) koji krade prostor. -->
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
