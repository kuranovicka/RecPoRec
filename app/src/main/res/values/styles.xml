<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:background">@drawable/key_button_shape</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <!-- Materijal tema po difoltu primorava jedan red bez preloma i tiho seče tekst.
             Pokušaj sa prelaskom u 2 reda je napravio preklapanje sa susednim redom (nema
             dovoljno visine) - vraćen jedan red, ali sa ellipsize="end" kao sigurnosna mreža
             (ako nešto ipak ne stane, dodaju se "..." umesto tihog sečenja bez traga).
             VAŽNO: TalkBack čita contentDescription, NE vidljivi tekst - ovo je bio čisto
             vizuelni problem, nikad nije uticao na čitač ekrana. -->
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
