<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/btn_voice"
        android:titleTextColor="@color/text_primary"
        app:title="Rečnik izgovora" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:paddingBottom="8dp"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:text="Ovde biraš šta program da izgovori umesto originalne reči (npr. John → Džon). Dodir na unos otvara izmenu, brisanje ili probni izgovor. Unosi označeni sa (ugrađeno) su iz ugrađenog rečnika - dodirom na njih možeš dodati svoju zamenu." />

    <EditText
        android:id="@+id/inputSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_primary"
        android:hint="Pretraga (npr. deo reči)"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:contentDescription="Pretraga rečnika izgovora" />

    <Button
        android:id="@+id/btnWordList"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:textSize="18sp"
        android:backgroundTint="@color/btn_speed"
        android:textColor="@color/button_text"
        android:text="Lista reči" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPronunciation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btnAddEntry"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_page_nav"
        android:textColor="@color/button_text"
        android:text="Dodaj reč" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnImportDictionary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textSize="18sp"
            android:backgroundTint="@color/btn_chapter"
            android:textColor="@color/button_text"
            android:text="Uvezi" />

        <Button
            android:id="@+id/btnExportDictionary"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:backgroundTint="@color/btn_chapter"
            android:textColor="@color/button_text"
            android:text="Izvezi" />

    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_combined"
        android:textColor="@color/button_text"
        android:text="Nazad" />

</LinearLayout>
