<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/btn_voice"
        android:titleTextColor="@color/text_primary"
        app:title="@string/menu_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <Switch
        android:id="@+id/switchBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_chapter"
        android:trackTint="@color/btn_chapter"
        android:text="@string/setting_background"
        android:contentDescription="@string/setting_background" />

    <Switch
        android:id="@+id/switchUninterrupted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_timer"
        android:trackTint="@color/btn_timer"
        android:text="@string/setting_uninterrupted"
        android:contentDescription="@string/setting_uninterrupted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchShake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_speed"
            android:trackTint="@color/btn_speed"
            android:text="@string/setting_shake"
            android:contentDescription="@string/setting_shake" />
    </LinearLayout>

    <Switch
        android:id="@+id/switchSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_volume"
        android:trackTint="@color/btn_volume"
        android:text="Zvuk"
        android:contentDescription="Zvuk - kratak zvuk pri dodiru dugmadi" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchSentencePause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_page_nav"
            android:trackTint="@color/btn_page_nav"
            android:text="@string/setting_sentence_pause"
            android:contentDescription="@string/setting_sentence_pause" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchParagraphPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_timer"
            android:trackTint="@color/btn_timer"
            android:text="Pauza između pasusa"
            android:contentDescription="Pauza između pasusa - primenjuje se umesto obične pauze na kraju pasusa" />
    </LinearLayout>

    <Switch
        android:id="@+id/switchAutoNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_chapter"
        android:trackTint="@color/btn_chapter"
        android:text="@string/setting_auto_next"
        android:contentDescription="@string/setting_auto_next" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchAutoRead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_wakeup"
            android:trackTint="@color/btn_wakeup"
            android:text="Automatski čitaj aktivni dokument"
            android:contentDescription="Automatski čitaj aktivni dokument" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchBuiltInPronunciationDict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_chapter"
            android:trackTint="@color/btn_chapter"
            android:text="Koristi ugrađeni rečnik izgovora"
            android:contentDescription="Koristi ugrađeni rečnik izgovora" />

        <Button
            android:id="@+id/btnPronunciationDictionary"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_chapter"
            android:textColor="@color/button_text"
            android:text="Rečnik izgovora" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:text="Navigacija po stranicama, minutama, oznakama, ili rečenicama" />

        <Button
            android:id="@+id/btnNavigationMode"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_page_nav"
            android:textColor="@color/button_text"
            android:text="Stranica" />
    </LinearLayout>

    <Switch
        android:id="@+id/switchDeleteOriginalAudioFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_chapter"
        android:trackTint="@color/btn_chapter"
        android:text="Obriši originalni zvučni folder nakon pakovanja"
        android:contentDescription="Obriši originalni zvučni folder nakon pakovanja." />

    <Button
        android:id="@+id/btnExportSettings"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_chapter"
        android:textColor="@color/button_text"
        android:contentDescription="Izvezi podešavanja u fajl. Dug pritisak: napravi rezervnu kopiju dokumenata."
        android:text="Izvezi podešavanja u fajl" />

    <Button
        android:id="@+id/btnImportSettings"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="20dp"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_chapter"
        android:textColor="@color/button_text"
        android:contentDescription="Uvezi podešavanja iz fajla. Dug pritisak: vrati rezervnu kopiju."
        android:text="Uvezi podešavanja iz fajla" />

    <Button
        android:id="@+id/btnResetGeneralDefaults"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="20dp"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_page_nav"
        android:textColor="@color/button_text"
        android:text="Vrati na zadano" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_combined"
        android:textColor="@color/button_text"
        android:text="Nazad" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>
