<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/btn_voice"
        android:titleTextColor="@color/text_primary"
        app:title="@string/menu_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <Switch
        android:id="@+id/switchBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_chapter"
        android:trackTint="@color/btn_chapter"
        android:text="@string/setting_background"
        android:contentDescription="@string/setting_background" />

    <Switch
        android:id="@+id/switchUninterrupted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_timer"
        android:trackTint="@color/btn_timer"
        android:text="@string/setting_uninterrupted"
        android:contentDescription="@string/setting_uninterrupted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchShake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_speed"
            android:trackTint="@color/btn_speed"
            android:text="@string/setting_shake"
            android:contentDescription="@string/setting_shake" />

        <!-- Vidljivo samo kad je drmanje uključeno -->
        <RadioGroup
            android:id="@+id/groupShakeSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioShakeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/btn_speed"
                android:text="Blago" />

            <RadioButton
                android:id="@+id/radioShakeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/btn_speed"
                android:text="Srednje" />

            <RadioButton
                android:id="@+id/radioShakeStrong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/btn_speed"
                android:text="Jako" />
        </RadioGroup>
    </LinearLayout>

    <Switch
        android:id="@+id/switchSound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_volume"
        android:trackTint="@color/btn_volume"
        android:text="Zvuk"
        android:contentDescription="Zvuk - kratak zvuk pri dodiru dugmadi" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="4dp">

        <Switch
            android:id="@+id/switchSentencePause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:thumbTint="@color/btn_page_nav"
            android:trackTint="@color/btn_page_nav"
            android:text="@string/setting_sentence_pause"
            android:contentDescription="@string/setting_sentence_pause" />

        <!-- Vidljivo samo kad je pauza između rečenica uključena -->
        <RadioGroup
            android:id="@+id/groupSentencePauseMs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/radioPause300"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/btn_page_nav"
                android:text="300 ms" />

            <RadioButton
                android:id="@+id/radioPause400"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/btn_page_nav"
                android:text="400 ms" />

            <RadioButton
                android:id="@+id/radioPause500"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/btn_page_nav"
                android:text="500 ms" />
        </RadioGroup>
    </LinearLayout>

    <Switch
        android:id="@+id/switchAutoNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:thumbTint="@color/btn_chapter"
        android:trackTint="@color/btn_chapter"
        android:text="@string/setting_auto_next"
        android:contentDescription="@string/setting_auto_next" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:text="Navigacija: po stranici, minutima ili oznakama" />

        <Button
            android:id="@+id/btnNavigationMode"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="10dp"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_page_nav"
            android:textColor="@color/button_text"
            android:text="Stranica" />
    </LinearLayout>

    </LinearLayout>
    </ScrollView>

</LinearLayout>
