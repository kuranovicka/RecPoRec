<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/btn_voice"
        android:titleTextColor="@color/text_primary"
        app:title="@string/app_name">

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="@string/menu_options_button"
            android:src="@android:drawable/ic_menu_more" />
    </androidx.appcompat.widget.Toolbar>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDocuments"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp" />

            <TextView
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone"
                android:padding="24dp"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:text="@string/no_documents" />
        </FrameLayout>

        <!-- Desna kolona: dodavanje dokumenta i izlaz iz aplikacije -->
        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="12dp">

            <Button
                android:id="@+id/btnAddDocument"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:textSize="20sp"
                android:backgroundTint="@color/btn_chapter"
                android:textColor="@color/button_text"
                android:background="@drawable/key_button_shape"
                android:text="@string/add_document" />

            <Button
                android:id="@+id/btnGeneralActions"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:backgroundTint="@color/btn_combined"
                android:textColor="@color/button_text"
                android:background="@drawable/key_button_shape"
                android:contentDescription="Opšte radnje: odaberi sve, obriši odabrano"
                android:text="Opšte radnje" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                android:textSize="20sp"
                android:backgroundTint="@color/btn_page_nav"
                android:textColor="@color/button_text"
                android:background="@drawable/key_button_shape"
                android:contentDescription="Izađi iz aplikacije, zaustavlja i rad u pozadini"
                android:text="Izlaz" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
