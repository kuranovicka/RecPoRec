<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/btn_voice"
            android:titleTextColor="@color/text_primary"
            app:title="Opšta podešavanja glasa" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:text="Ovo važi za svaki dokument, osim ako se za njega posebno ne izabere drugi jezik." />

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_margin="16dp"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_chapter"
            android:textColor="@color/button_text"
            android:text="Jezik" />

        <TextView
            android:id="@+id/textLanguageStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textSize="16sp"
            android:textColor="@color/btn_page_nav"
            android:accessibilityLiveRegion="polite"
            android:text="Nije izabrano" />

        <Button
            android:id="@+id/btnVoice"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_margin="16dp"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_voice"
            android:textColor="@color/button_text"
            android:text="Glas" />

        <TextView
            android:id="@+id/textVoiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:textSize="16sp"
            android:textColor="@color/btn_page_nav"
            android:accessibilityLiveRegion="polite"
            android:text="Nije izabran" />

        <TextView
            android:id="@+id/textSpeedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:accessibilityLiveRegion="polite"
            android:text="Brzina: 100%" />

        <SeekBar
            android:id="@+id/seekSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:contentDescription="Brzina čitanja. Dvostruko dodirni i prevuci, ili koristi dugmad ispod."
            android:max="270"
            android:progress="70"
            android:progressTint="@color/btn_speed"
            android:thumbTint="@color/btn_speed" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnSpeedDown"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="18sp"
                android:backgroundTint="@color/btn_speed"
                android:textColor="@color/button_text"
                android:contentDescription="Smanji brzinu čitanja"
                android:text="−" />

            <Button
                android:id="@+id/btnSpeedUp"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="18sp"
                android:backgroundTint="@color/btn_speed"
                android:textColor="@color/button_text"
                android:contentDescription="Povećaj brzinu čitanja"
                android:text="+" />
        </LinearLayout>

        <TextView
            android:id="@+id/textVolumeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:accessibilityLiveRegion="polite"
            android:text="Jačina: 100%" />

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Jačina zvuka. Dvostruko dodirni i prevuci, ili koristi dugmad ispod."
            android:max="100"
            android:progress="100"
            android:progressTint="@color/btn_volume"
            android:thumbTint="@color/btn_volume" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnVolumeDown"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:textSize="18sp"
                android:backgroundTint="@color/btn_volume"
                android:textColor="@color/button_text"
                android:contentDescription="Smanji jačinu zvuka"
                android:text="−" />

            <Button
                android:id="@+id/btnVolumeUp"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="18sp"
                android:backgroundTint="@color/btn_volume"
                android:textColor="@color/button_text"
                android:contentDescription="Povećaj jačinu zvuka"
                android:text="+" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
