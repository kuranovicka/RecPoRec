<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <SeekBar
        android:id="@+id/seekRestMinutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Broj minuta za odmor, od 10 do 240"
        android:max="23"
        android:progress="2"
        android:progressTint="@color/btn_timer"
        android:thumbTint="@color/btn_timer" />

    <TextView
        android:id="@+id/textRestMinutesStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:accessibilityLiveRegion="polite"
        android:text="30 minuta" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:text="Ili, umesto klizača, upiši tačno vreme buđenja:" />

    <EditText
        android:id="@+id/editWakeTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="text"
        android:hint="npr. 5:20"
        android:contentDescription="Probudi me u - upiši vreme u formi sat:minut, na primer 5:20. Ako popuniš ovo polje, klizač se ne koristi."
        android:textSize="20sp" />

</LinearLayout>
