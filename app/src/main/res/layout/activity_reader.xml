<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <!-- "Opcije" - isto kao na glavnom ekranu, gornji desni ugao. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/btn_voice"
        android:titleTextColor="@color/text_primary"
        app:title="@string/app_name">

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@android:color/transparent"
            android:contentDescription="@string/menu_options_button"
            android:src="@android:drawable/ic_menu_more" />
    </androidx.appcompat.widget.Toolbar>

    <!-- Traka statusa - smanjena (manji font, manji padding) da ne zauzima previse prostora,
         posebno kad nema aktivnog tajmera/budjenja (te linije se i sakrivaju kad su neaktivne). -->
    <LinearLayout
        android:id="@+id/layoutStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/textDocTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Naslov" />

        <TextView
            android:id="@+id/textPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/textElapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/textRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/textTimerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:text="Tajmer nije aktivan." />

        <TextView
            android:id="@+id/textRestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:text="Odmor nije aktivan." />
    </LinearLayout>

    <!-- Numerička tastatura - SVAKI red ima FIKSNU visinu u dp (ne procenat/weight koji se
         menja) - Marinin izričit zahtev da dugmad budu stvarno fiksna, ne "bezi" menjanjem
         proporcija između build-ova. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Red: Oznake / Idi na -->
        <LinearLayout
            android:id="@+id/layoutRow1"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBookmarks" style="@style/KeyButton"
                android:backgroundTint="@color/btn_goto_page"
                android:contentDescription="Oznake - dodaj, ukloni ili ukloni sve oznake u ovom dokumentu. Dug pritisak: brzo dodaj oznaku."
                android:textSize="18sp"
                android:text="🔖 Oznake" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnGoTo" style="@style/KeyButton"
                android:backgroundTint="@color/btn_goto_page"
                android:contentDescription="Idi na stranicu, minut ili oznaku. Dug pritisak: idi na početak dokumenta."
                android:textSize="18sp"
                android:text="➜ Idi na" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSelectAll" style="@style/KeyButton"
                android:backgroundTint="@color/btn_combined"
                android:contentDescription="Odaberi sve. Dug pritisak: kopiraj odabrano."
                android:textSize="18sp"
                android:text="Odaberi" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSearchText" style="@style/KeyButton"
                android:backgroundTint="@color/btn_goto_page"
                android:contentDescription="Pretraži tekst dokumenta. Dug pritisak: ponovi poslednju pretragu."
                android:textSize="18sp"
                android:text="🔍 Pretraga" />
        </LinearLayout>

        <!-- Samo vizuelna linija - razdvaja redove za slabovide, TalkBack je potpuno
             preskace (importantForAccessibility="no") i ne menja redosled dugmadi. -->
        <View
            android:id="@+id/dividerRow1"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/slider_track"
            android:importantForAccessibility="no" />

        <!-- Red: Prethodno poglavlje / Automatski listaj / Sledeće poglavlje - sve troje je
             "kretanje kroz dokument", logičnija grupa nego Tajmer koji tu nije pripadao. -->
        <LinearLayout
            android:id="@+id/layoutRow2"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPrevChapter" style="@style/KeyButton"
                android:backgroundTint="@color/btn_chapter"
                android:contentDescription="@string/btn_prev_chapter"
                android:textSize="18sp"
                android:text="⏮ Pogl." />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnAutoScroll" style="@style/KeyButton"
                android:backgroundTint="@color/btn_combined"
                android:contentDescription="Automatski listaj dokument."
                android:text="Automatski" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnNextChapter" style="@style/KeyButton"
                android:backgroundTint="@color/btn_chapter"
                android:contentDescription="@string/btn_next_chapter"
                android:textSize="18sp"
                android:text="Pogl. ⏭" />
        </LinearLayout>

        <View
            android:id="@+id/dividerRow2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/slider_track"
            android:importantForAccessibility="no" />

        <!-- Red: Tajmer / Probudi me / Zakaži čitanje - sve troje je "uradi nešto u vezi sa
             vremenom", logičnija grupa nego prethodni raspored. -->
        <LinearLayout
            android:id="@+id/layoutRow3"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnTimer" style="@style/KeyButton"
                android:backgroundTint="@color/btn_timer"
                android:contentDescription="@string/btn_timer"
                android:text="⏱ Tajmer" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnWakeUp" style="@style/KeyButton"
                android:backgroundTint="@color/btn_wakeup"
                android:contentDescription="Probudi me u tačno vreme. Dug pritisak: isključi buđenje."
                android:textSize="18sp"
                android:text="⏰ Probudi" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnScheduleReading" style="@style/KeyButton"
                android:backgroundTint="@color/btn_voice"
                android:contentDescription="Zakaži čitanje."
                android:text="Zakaži" />
        </LinearLayout>

        <View
            android:id="@+id/dividerRow3"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/slider_track"
            android:importantForAccessibility="no" />

        <!-- Red: korak nazad / korak napred -->
        <LinearLayout
            android:id="@+id/layoutRow5"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnStepBack" style="@style/KeyButton"
                android:layout_weight="2"
                android:backgroundTint="@color/btn_page_nav"
                android:contentDescription="@string/slider_back"
                android:text="◀ 5%" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRemindMe" style="@style/KeyButton"
                android:backgroundTint="@color/btn_timer"
                android:contentDescription="Podsetnik, vraća dokument unazad. Dug pritisak: ponovi poslednji podsetnik."
                android:textSize="18sp"
                android:text="⏰ Podseti" />

            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnStepForward" style="@style/KeyButton"
                android:layout_weight="2"
                android:backgroundTint="@color/btn_page_nav"
                android:contentDescription="@string/slider_forward"
                android:text="5% ▶" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/dividerRow4"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/slider_track"
        android:importantForAccessibility="no" />

    <!-- Play-pauza - JEDINI element koji raste (weight=1), pa prirodno "sedne" u sredinu
         preostalog prostora, jer je tastatura iznad FIKSNE visine, a Kontrole/Nazad/klizač
         ispod su takođe fiksni. Ovo tačno prati Marinin opis: sve ostalo fiksno, Play-pauza
         negde na sredini ekrana, veliko i istaknuto. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlayPause" style="@style/KeyButton"
            android:backgroundTint="@color/btn_play"
            android:contentDescription="@string/btn_play_pause"
            android:text="▶ / ⏸" />
    </LinearLayout>

    <!-- Kontrole (levo) i Nazad (desno) - JEDAN red, fiksna visina, tačno iznad klizača,
         kako je Marina tražila. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnToggleControls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:textSize="18sp"
            android:backgroundTint="@color/btn_combined"
            android:textColor="@color/button_text"
            android:contentDescription="Prikaži ili sakrij kontrole. Dug pritisak: Kratak predah, pauzira čitanje na 15 minuta."
            android:text="👁 Kontrole" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="18sp"
            android:backgroundTint="@color/btn_combined"
            android:textColor="@color/button_text"
            android:contentDescription="Nazad. Zatvara dokument, vraća na listu. Dug pritisak: pošalji aplikaciju u pozadinu."
            android:text="Nazad" />

    </LinearLayout>

    <!-- Klizač napretka kroz knjigu - namerno POSLEDNJI element na ekranu, na samom dnu, i
         namerno NEUPADLJIV (manji, prigušena boja). -->
    <SeekBar
        android:id="@+id/seekProgress"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="@string/slider_position"
        android:max="100"
        android:progressTint="@color/slider_track"
        android:thumbTint="@color/slider_track" />

</LinearLayout>
