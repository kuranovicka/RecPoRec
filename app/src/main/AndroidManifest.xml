<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Opciono - za pouzdanije prepoznavanje telefonskog poziva (rezervni mehanizam uz
         audio fokus, koji se na nekim uredjajima pokazao nepouzdanim). Ako korisnik odbije
         ovu dozvolu, app i dalje radi normalno, samo se oslanja samo na audio fokus. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Za pouzdano "Probudi me u" - isti mehanizam koji koriste prave budilnik aplikacije,
         da bi alarm sigurno dosao do korisnice cak i kad Android/proizvodjac agresivno
         ogranicava rad u pozadini (potvrdjeno da isti problem ima i Spotify na Samsung
         uredjajima). setAlarmClock() ne trazi posebnu dozvolu za sam alarm, ali prikaz
         preko zakljucanog ekrana trazi ovu dozvolu (od Android 14 rezervisano bas za
         pozive i budilnike, sto nase "Probudi me u" i jeste). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!-- Za vracanje zakazanog budjenja/citanja posle restarta telefona - AlarmManager sam
         brise sve alarme na restart, ova (obicna, automatski odobrena) dozvola omogucava da
         se to zakazivanje tiho vrati, umesto da budjenje bez traga nestane. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RecPoRecApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecPoRec">

        <activity
            android:name=".ui.DocumentListActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Otvori sa" iz Google Diska, fajl menadžera i drugih app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- "Podeli" (Share) iz Google Diska i drugih app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ReaderActivity"
            android:exported="false" />

        <!-- Cilj prečice "Nastavi čitanje" (dug pritisak na ikonicu app-e) - providan, nema
             sopstveni izgled, samo prosledi na pravi ekran. exported=true jer ga sistem
             (launcher) pokreće spolja preko static shortcuts.xml. -->
        <activity
            android:name=".ui.ContinueReadingActivity"
            android:exported="true"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.StatsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.GlobalVoiceSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CombinedVoicesActivity"
            android:exported="false" />

        <activity
            android:name=".ui.HelpActivity"
            android:exported="false" />

        <!-- Puni ekran preko zakljucanog ekrana kad "Probudi me u" treba da zazvoni - isti
             mehanizam koji koriste prave budilnik aplikacije, da bi radilo cak i kad je
             ekran zakljucan i telefon "u snu". -->
        <activity
            android:name=".ui.WakeAlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <receiver
            android:name=".service.WakeAlarmReceiver"
            android:exported="false" />

        <!-- exported=true JE potrebno ovde (za razliku od WakeAlarmReceiver iznad) - ovo
             prijemnik pokrece SAM SISTEM (spolja), ne nasa sopstvena PendingIntent. -->
        <receiver
            android:name=".service.BootRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.ReadingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
